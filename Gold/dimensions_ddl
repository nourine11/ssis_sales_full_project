if object_id ('gold.DIM_Date','U')is not null
drop table gold.DIM_Date

CREATE TABLE gold.DIM_Date
(
    date_key INT PRIMARY KEY,
    full_date DATE NOT NULL,
    [year] INT,
    [quarter] INT,
    [month] INT,
    month_name NVARCHAR(20),
    [day] INT,
    day_of_week INT,
    day_name NVARCHAR(20),
    is_weekend BIT
);
